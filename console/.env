# port 端口号
VITE_PORT=8888

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=false

# 打包是否开启 cdn（源文件 utils/build.ts），可自行修改
VITE_OPEN_CDN=false

# public path 配置线上环境路径（打包）、本地通过 http-server 访问时，请置空即可
VITE_PUBLIC_PATH=

# 线上地址，用于文件访问路径拼接
VITE_ONLINE_DOMAIN=auth.wuntsong.com

# 项目名称
VITE_PROJECT_NAME=创信易
VITE_PROJECT_NAME_LONG=创信易用户中心

# 服务号名称
VITE_FUWUHAO_NAME=创信易

# 企业简称
VITE_COMPANY_NAME=桓创

# Face回调
VITE_FACE_CALLBACK=https://auth.wuntsong.com/api/v1/public/checker-before/allow-website/alipay/face/url

# 微信登录成功
VITE_WECHAT_LOGIN_SUCCESS_CALLBACK=https://auth.wuntsong.com/weixinloginsuccess

# 微信绑定成功
VITE_WECHAT_BIND_SUCCESS_CALLBACK=https://auth.wuntsong.com/weixinbindsuccess
