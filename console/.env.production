# 线上环境
ENV=production

# 线上环境接口地址
VITE_API_URL=/api/v1
VITE_WS_URL=wss://auth.wuntsong.com/api/v1/user/ws
VITE_PUBLIC_PATH='/'

# 线上地址，用于文件访问路径拼接
VITE_ONLINE_DOMAIN=auth.wuntsong.com

# Face回调
VITE_FACE_CALLBACK=https://auth.wuntsong.com/api/v1/public/checker-before/allow-website/alipay/face/url

# 微信登录成功
VITE_WECHAT_LOGIN_SUCCESS_CALLBACK=https://auth.wuntsong.com/weixinloginsuccess

# 微信绑定成功
VITE_WECHAT_BIND_SUCCESS_CALLBACK=https://auth.wuntsong.com/weixinbindsuccess

VITE_VXWK_URL=https://console.vxwk.com/

VITE_NOT_CONSOLE=true